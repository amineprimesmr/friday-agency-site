# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# IDE / agent local
.cursor/
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Supabase CLI (lien local, pas versionné)
supabase/.temp/

# vercel
.vercel

# ressources générées (sync depuis Ressources/ au build)
/public/trackapp-ressources/*
!/public/trackapp-ressources/.gitkeep

# typescript
*.tsbuildinfo
.env*.local
