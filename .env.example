# URL canonique du site (production & previews Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# JWT cookie après paiement — chaîne aléatoire ≥16 caractères (obligatoire en production)
SUBSCRIPTION_SECRET=change-me-to-a-long-random-string

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Stripe — prix récurrents (Billing → Products → Price ID)
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=

# Webhook endpoint /api/webhooks/stripe (optionnel au MVP)
STRIPE_WEBHOOK_SECRET=

# Meta Ad Library (Graph API ads_archive) — https://www.facebook.com/ads/library/api/
# Jeton avec accès « ads_read » / Ad Library — ne jamais exposer côté client
META_AD_LIBRARY_ACCESS_TOKEN=
# Optionnel : version Graph (défaut v21.0)
# META_GRAPH_API_VERSION=v21.0

# TikTok Research API — Ad Library (client_credentials)
# https://developers.tiktok.com/doc/commercial-content-api-getting-started
# Produits : Research API + scope research.adlib.basic
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ─── Avatar Studio ────────────────────────────────────────────────────────────
# Optional Avatar Studio perf (OpenAI GPT Image 2 — smaller / lower quality = faster)
# OPENAI_AVATAR_IMAGE_SIZE=1024x1024
# OPENAI_AVATAR_EDIT_QUALITY=medium
# Use low for maximum speed, high for slowest/best, off to omit the parameter entirely
OPENAI_API_KEY=

# Anthropic — analyse photo (Character bible) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Kling AI — génération vidéo officielle (kling-v2-1 Pro)
# https://klingai.com/developer → API Keys → Access Key + Secret Key
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
