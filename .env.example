# URL canonique du site en production.
# En local, vous pouvez remplacer par http://localhost:3000 dans `.env.local`.
NEXT_PUBLIC_APP_URL=https://trackapp.fr

# JWT cookie après paiement — chaîne aléatoire ≥16 caractères (obligatoire en production)
SUBSCRIPTION_SECRET=change-me-to-a-long-random-string

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Stripe — abonnements Trackapp (Billing → Products → Price IDs)
# Mensuel 39 € / mois — utiliser STRIPE_PRICE_ID_TRACKAPP ou STRIPE_PRICE_ID_MONTHLY
STRIPE_PRICE_ID_MONTHLY=
# Annuel 99 € / an (même produit, intervalle yearly)
STRIPE_PRICE_ID_YEARLY=

# Webhook endpoint /api/webhooks/stripe — obligatoire pour commissions affiliés
# Événements à activer : checkout.session.completed, invoice.paid, customer.subscription.deleted, charge.refunded
STRIPE_WEBHOOK_SECRET=

# Affiliation : activer Stripe Connect (Express) sur le compte plateforme
# https://dashboard.stripe.com/connect — les affiliés reçoivent leurs virements via Connect

# Coupon Stripe (ex. −40 %) appliqué au checkout abonnement lorsque le filleul a le cookie de parrainage.
# STRIPE_COUPON_ID_REFERRAL_FRIEND=

# Trackapp SaaS — Supabase Auth + espace app (créez le projet puis coller les clés)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Démo locale uniquement : email utilisé par POST /api/dev/trackapp-demo-session (bouton pied de page hors prod)
# TRACKAPP_DEV_DEMO_EMAIL=dev-local@trackapp.invalid

# Prix Stripe « débloquer Trackapp » (sinon utilise STRIPE_PRICE_ID_MONTHLY)
STRIPE_PRICE_ID_TRACKAPP=

# Hero visuel modal auth (desktop colonne droite) — URL absolue ou chemin sous /public
# NEXT_PUBLIC_TRACKAPP_AUTH_HERO=https://...

# OAuth Supabase : ajouter les Redirect URLs suivantes dans le projet
# …/trackapp/auth/callback

# Meta Ad Library (Graph API ads_archive) — https://www.facebook.com/ads/library/api/
# Jeton avec accès « ads_read » / Ad Library — ne jamais exposer côté client
META_AD_LIBRARY_ACCESS_TOKEN=
# Optionnel : version Graph (défaut v21.0)
# META_GRAPH_API_VERSION=v21.0

# TikTok Commercial Content API — Ad Library (client_credentials après approbation)
# Demande d’accès : https://developers.tiktok.com/application/commercial-content-api
# Clés projet : https://developers.tiktok.com/research/ · Doc : https://developers.tiktok.com/doc/commercial-content-api-getting-started
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ─── Avatar Studio ────────────────────────────────────────────────────────────
# Optionnel : modèle OpenAI pour inférer les liens marque (onglet Tracker Ads, secours sans lien FB sur la fiche)
# TRACKER_BRAND_OPENAI_MODEL=gpt-4o-mini
# Seuil 0–1 pour accepter facebook_url proposé par le modèle (sinon ignoré pour Ad Library)
# TRACKER_BRAND_FB_MIN_CONFIDENCE=0.55
# OPENAI_AVATAR_IMAGE_SIZE=1024x1024
# OPENAI_AVATAR_EDIT_QUALITY=medium
# low = plus rapide, high = défaut qualité max, off = sans paramètre quality
OPENAI_API_KEY=

# Upstash Redis — file d’attente jobs génération image (recommandé prod sur Vercel)
# https://console.upstash.com → créer une DB Redis → REST URL + token
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Modèle conversation atelier Avatar (défaut : haiku rapide ; ex. claude-sonnet-4-20250514)
# ANTHROPIC_STUDIO_MODEL=
# Affichage client du nom du modèle (optionnel, doit coller au modèle API)
# NEXT_PUBLIC_ANTHROPIC_STUDIO_MODEL=

# Anthropic — analyse photo + chats (Character bible, atelier, carrousel)
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optionnel : modèle pour le chat « concept carrousel » (sinon ANTHROPIC_STUDIO_MODEL / haiku)
# ANTHROPIC_CAROUSEL_MODEL=claude-sonnet-4-20250514

# Kling AI — génération vidéo officielle (kling-v2-1 Pro)
# https://klingai.com/developer → API Keys → Access Key + Secret Key
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
