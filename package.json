{
  "name": "friday-saas",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbo --hostname 127.0.0.1",
    "dev:webpack": "next dev --hostname 127.0.0.1",
    "clean": "rm -rf .next node_modules/.cache",
    "reset:dev": "bash scripts/dev-reset.sh",
    "dev:fresh": "npm run clean && npm run dev",
    "dev:reset": "npm run reset:dev && npm run dev",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@upstash/redis": "^1.38.0",
    "@vercel/functions": "^3.5.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.3",
    "next": "15.5.18",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
